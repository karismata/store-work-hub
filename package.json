{
  "name": "store-work-hub",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:exe": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.storeworkhub.app",
    "productName": "매장 관리 업무 Hub",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "매장 관리 업무 Hub"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "karismata",
        "repo": "store-work-hub"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
